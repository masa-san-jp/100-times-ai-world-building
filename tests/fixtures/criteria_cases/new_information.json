[
  {
    "id": "new-information-brief-text-not-counted",
    "criterion": "new_information",
    "check": "fact.new_information",
    "input": {
      "fact_kinds": [
        "number"
      ],
      "facts": [
        {
          "subject": "Capacity",
          "value": 12,
          "unit": "q2v",
          "fact": "Capacity is 12 q2v."
        }
      ],
      "brief": {
        "statements": [
          {
            "id": "s1",
            "text": "Capacity is 12 q2v."
          }
        ]
      }
    },
    "expected": "pass",
    "note": "Brief text is not compared with numbers: the entity derives from the brief, so restating its measurement is not a repetition of an existing number fact."
  },

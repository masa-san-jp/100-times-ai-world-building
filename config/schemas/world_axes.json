{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "axes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "domain": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "meaning": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "statement_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "domain",
          "name",
          "meaning",
          "weight",
          "statement_ids",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "axes"
  ],
  "additionalProperties": false
}

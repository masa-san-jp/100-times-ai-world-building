{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdicts": {
      "type": "object",
      "properties": {
        "consistent": {
          "type": "boolean"
        },
        "objective": {
          "type": "boolean"
        },
        "no_outside_premises": {
          "type": "boolean"
        }
      },
      "required": [
        "consistent",
        "objective",
        "no_outside_premises"
      ],
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "enum": [
              "name",
              "summary"
            ]
          },
          "criterion": {
            "enum": [
              "consistent",
              "objective",
              "no_outside_premises"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "criterion",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "verdicts",
    "issues"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[^ \t\n\r\u3000()（）:：,、;；。]+$"
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false
}

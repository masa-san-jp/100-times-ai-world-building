{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "pattern": "^[^\\s()（）:：,、;；。]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    }
  },
  "required": [
    "name",
    "description"
  ],
  "additionalProperties": false
}

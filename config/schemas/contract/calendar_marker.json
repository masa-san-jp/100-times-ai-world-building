{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "marker": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12,
      "pattern": "^[^ \t\n\r\u3000()（）:：,、;；。]+$"
    }
  },
  "required": [
    "marker"
  ],
  "additionalProperties": false
}

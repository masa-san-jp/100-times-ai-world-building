{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "pattern": "^[^\\s()（）:：,、;；。]+$"
    }
  },
  "required": [
    "capability"
  ],
  "additionalProperties": false
}

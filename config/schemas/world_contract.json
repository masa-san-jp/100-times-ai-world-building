{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "calendar": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[^\\s()（）:：,、;；。]+$"
        },
        "origin": {
          "type": "string",
          "maxLength": 160
        },
        "markers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12,
            "pattern": "^[^\\s()（）:：,、;；。]+$"
          },
          "maxItems": 4,
          "minItems": 1
        }
      },
      "required": [
        "name",
        "origin",
        "markers"
      ],
      "additionalProperties": false
    },
    "technology": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 160
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 160
          },
          "maxItems": 4
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "symbol": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12,
                "pattern": "^[^\\s()（）:：,、;；]+$"
              },
              "quantity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              }
            },
            "required": ["symbol", "quantity"],
            "additionalProperties": false
          },
          "maxItems": 4,
          "minItems": 1
        }
      },
      "required": [
        "description",
        "capabilities",
        "units"
      ],
      "additionalProperties": false
    },
    "society": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 160
        },
        "institutions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30,
                "pattern": "^[^\\s()（）:：,、;；。]+$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": ["name", "description"],
            "additionalProperties": false
          },
          "maxItems": 4
        }
      },
      "required": [
        "description",
        "institutions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "calendar",
    "technology",
    "society"
  ],
  "additionalProperties": false
}
